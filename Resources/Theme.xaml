<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RailBrush" Color="#B4D2E0" />
    <SolidColorBrush x:Key="RailBorderBrush" Color="#91B8CA" />
    <SolidColorBrush x:Key="RailTextBrush" Color="#143D55" />
    <SolidColorBrush x:Key="LineBrush" Color="#DFE6EE" />
    <SolidColorBrush x:Key="TextBrush" Color="#111827" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#637083" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0877C9" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#21A045" />

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="RailButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Foreground" Value="{StaticResource RailTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#F7FBFE" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="19">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#EDF4FA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsListening}" Value="True">
                <Setter Property="Background" Value="#EDF4FA" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="PendingAttachmentChipTemplate">
        <Border Background="#EEF5FB"
                BorderBrush="#D6E4EF"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,8,8"
                Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Border Background="#D7ECFB"
                        CornerRadius="6"
                        Padding="6,2"
                        Margin="0,0,8,0">
                    <TextBlock Text="{Binding Kind}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#075985"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="#1F2937"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Content="x"
                        Margin="10,0,0,0"
                        Padding="0"
                        Width="16"
                        Height="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="MessageAttachmentChipTemplate">
        <Button Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Margin="0,10,8,0"
                Cursor="Hand">
            <Border Background="#D7ECFB"
                    CornerRadius="8"
                    Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Kind}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#075985"
                           Margin="0,0,7,0" />
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="#0F172A"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            </Border>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="MessageTemplate">
        <Grid Margin="{Binding RowMargin}"
              HorizontalAlignment="{Binding RowAlignment}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="34"
                    Height="34"
                    Background="#F0EAFE"
                    CornerRadius="17"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding DollyAvatarVisibility}">
                <TextBlock Text="D"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="#553187" />
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Label}"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="4,0,4,6"
                           HorizontalAlignment="{Binding MetaAlignment}" />

                <Border Background="{Binding BubbleBrush}"
                        CornerRadius="{Binding BubbleCornerRadius}"
                        Padding="18,14"
                        MaxWidth="640">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Paragraphs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               FontSize="16"
                                               LineHeight="24"
                                               Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Margin="0,0,0,12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Attachments}"
                                      ItemTemplate="{StaticResource MessageAttachmentChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2"
                    Width="34"
                    Height="34"
                    Background="#D9F3EA"
                    CornerRadius="17"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding UserAvatarVisibility}">
                <TextBlock Text="U"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="#086B5A" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="VitaMasteryQuestRowTemplate">
        <Border Background="White"
                BorderBrush="#E4EAF1"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EvidenceSummary}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding EvidenceHint}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Points}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
