<Window x:Class="VitaMR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VitaMR.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VitaMR"
        Width="1366"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#FBFDFF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:LeftRailControl Grid.Column="0" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="136" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:TopStatusBarControl Grid.Row="0" />
            <Grid Grid.Row="1">
                <controls:ConversationView Visibility="{Binding ConversationVisibility}" />
                <controls:AdminDashboardControl Visibility="{Binding AdminDashboardVisibility}" />
                <controls:VitaMasteryControl Visibility="{Binding VitaMasteryVisibility}" />
            </Grid>
            <controls:OmniboxControl Grid.Row="2" />
        </Grid>

        <controls:RightPreviewPanelControl Grid.Column="2" />
    </Grid>
</Window>
