<Window x:Class="SafeHarborDeidDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Safe Harbor Cleaner"
        Width="1120"
        Height="760"
        MinWidth="880"
        MinHeight="620"
        Background="#F0FFFF"
        Icon="SafeHarbor_Cleaner.ico"
        AllowDrop="True"
        PreviewDragOver="Window_DragOver"
        PreviewDrop="Window_Drop"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CapsuleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0877C9"/>
            <Setter Property="BorderBrush" Value="#075985"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#075985"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#0C4A6E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0C4A6E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8A96A8"/>
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#EEF3F7"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#D6DEE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource CapsuleButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#21A045"/>
            <Setter Property="BorderBrush" Value="#168238"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#168238" BlurRadius="12" ShadowDepth="1" Opacity="0.18"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#178F3E"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#0F7130"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0F7130"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#9CA3AF"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#8A96A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallCapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource CapsuleButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>
    </Window.Resources>
        <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Safe Harbor Cleaner"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               ToolTip="Local HIPAA Safe Harbor candidate de-identification. Raw text stays on this machine."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open File" Style="{StaticResource CapsuleButtonStyle}" Margin="0,0,8,0" Click="OpenFile_Click"/>
                    <Button Content="Save Result" Style="{StaticResource CapsuleButtonStyle}" Click="SaveResult_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" Margin="0,12,0,0" Foreground="#374151" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AiModeButton"
                        Content="AI Mode"
                        Style="{StaticResource CapsuleButtonStyle}"
                        Margin="0,0,12,0"
                        Click="AiModeButton_Click"/>
                <CheckBox x:Name="AiModeCheckBox"
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          Content="Use AI Mode"/>
            </StackPanel>
        </Border>

                <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,10,12,8" LastChildFill="False">
                        <TextBlock Text="Input" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" DockPanel.Dock="Left"/>
                        <Button Content="Clear" Style="{StaticResource SmallCapsuleButtonStyle}" DockPanel.Dock="Right" Click="ClearInput_Click"/>
                        <Button Content="Clean Data" Style="{StaticResource PrimaryCapsuleButtonStyle}" Margin="0,0,8,0" DockPanel.Dock="Right" Click="RunDeid_Click"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="InputTextBox"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="17"
                                 BorderThickness="0"
                                 Padding="12"
                                 GotKeyboardFocus="InputTextBox_GotKeyboardFocus"
                                 TextChanged="InputTextBox_TextChanged"/>
                        <TextBlock x:Name="InputPlaceholderTextBlock"
                                   Text="Paste data here..."
                                   Margin="14,12,0,0"
                                   Foreground="#637083"
                                   FontSize="17"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Border Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        <DockPanel Margin="12,10,12,8" LastChildFill="False">
                            <TextBlock Text="Clean Result" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" DockPanel.Dock="Left"/>
                            <Button Content="Copy" Style="{StaticResource SmallCapsuleButtonStyle}" DockPanel.Dock="Right" Click="CopyResult_Click"/>
                        </DockPanel>
                        <TextBox x:Name="OutputTextBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="17"
                                 BorderThickness="0"
                                 Padding="12"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <TextBlock Foreground="#7C2D12" TextWrapping="Wrap">
                This tool attempts Safe Harbor candidate de-identification. It does not prove legal compliance or replace human privacy review. Images, scanned PDFs, audio, video, and legacy DOC files should be treated as needing review.
            </TextBlock>
        </Border>

        <Border x:Name="CopyPopup"
                Grid.RowSpan="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,58"
                Background="#111827"
                BorderBrush="#0877C9"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18,10"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="CopyPopupText"
                       Foreground="#FFFFFF"
                       FontWeight="SemiBold"
                       Text="Clean result copied."/>
        </Border>
    </Grid>
</Window>

