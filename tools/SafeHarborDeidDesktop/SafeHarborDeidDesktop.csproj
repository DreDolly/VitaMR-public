<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\Resources\SafeHarbor_Cleaner.ico</ApplicationIcon>
    <AssemblyName>SafeHarborCleaner</AssemblyName>
    <AssemblyTitle>Safe Harbor Cleaner</AssemblyTitle>
    <Product>Safe Harbor Cleaner</Product>
    <Version>1.3.0-beta</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3-beta</InformationalVersion>
    <Description>Local Windows Safe Harbor candidate de-identification desktop app.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DreDolly/VitaMR-public</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Resources\SafeHarbor_Cleaner.ico" Link="SafeHarbor_Cleaner.ico" />
  </ItemGroup>

</Project>




