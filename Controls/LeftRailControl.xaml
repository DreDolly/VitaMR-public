<UserControl x:Class="VitaMR.Controls.LeftRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource RailBrush}"
            BorderBrush="{StaticResource RailBorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid Margin="6,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Style="{StaticResource RailButtonStyle}"
                    Foreground="{StaticResource AccentBrush}"
                    Background="White"
                    Content="D"
                    ToolTip="Dolly chat"
                    Command="{Binding ShowConversationCommand}" />
            <Button Grid.Row="1"
                    Style="{StaticResource RailButtonStyle}"
                    Content="R"
                    ToolTip="Review panel"
                    Command="{Binding TogglePreviewPanelCommand}" />
            <Button Grid.Row="2"
                    Style="{StaticResource RailButtonStyle}"
                    Content="A"
                    ToolTip="Admin"
                    Command="{Binding ShowAdminDashboardCommand}" />
            <Button Grid.Row="5" Style="{StaticResource RailButtonStyle}" Content="S" Margin="0" />
        </Grid>
    </Border>
</UserControl>
