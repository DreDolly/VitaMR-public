<UserControl x:Class="VitaMR.Controls.OmniboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             PreviewDragEnter="Omnibox_PreviewDragEnter"
             PreviewDragLeave="Omnibox_PreviewDragLeave"
             PreviewDragOver="Omnibox_PreviewDragOver"
             PreviewDrop="Omnibox_PreviewDrop">
    <Grid Margin="180,0,180,20"
          AllowDrop="True"
          PreviewDragEnter="Omnibox_PreviewDragEnter"
          PreviewDragLeave="Omnibox_PreviewDragLeave"
          PreviewDragOver="Omnibox_PreviewDragOver"
          PreviewDrop="Omnibox_PreviewDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding Attachments}"
                      ItemTemplate="{StaticResource PendingAttachmentChipTemplate}"
                      Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                Padding="12,5"
                Margin="0,0,0,10"
                Background="#EAF3F8"
                BorderBrush="#5E9DC3"
                BorderThickness="2"
                CornerRadius="12"
                ToolTip="{Binding ActiveChartPath}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ActiveChartFocus}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="  "
                           FontSize="12" />
                <TextBlock Text="{Binding ActiveChartFocusDetail}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <Border x:Name="OmniboxBorder"
                Grid.Row="2"
                Padding="10"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="30"
                AllowDrop="True"
                PreviewDragEnter="Omnibox_PreviewDragEnter"
                PreviewDragLeave="Omnibox_PreviewDragLeave"
                PreviewDragOver="Omnibox_PreviewDragOver"
                PreviewDrop="Omnibox_PreviewDrop">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#D9E2EC" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragTargetActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="Background" Value="#F4FAFF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource IconButtonStyle}"
                        FontSize="20"
                        Content="+"
                        ToolTip="Attach a file"
                        IsEnabled="{Binding IsTaskInputEnabled}"
                        Command="{Binding AttachFilesCommand}" />

                <Grid Grid.Column="1" Margin="4,4,10,4">
                    <TextBox x:Name="PromptTextBox"
                             AllowDrop="True"
                             VerticalAlignment="Center"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             FontSize="16"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="34"
                             MaxHeight="164"
                             Padding="0,8"
                             IsEnabled="{Binding IsChatInputEnabled}"
                             Text="{Binding PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewDragEnter="Omnibox_PreviewDragEnter"
                             PreviewDragLeave="Omnibox_PreviewDragLeave"
                             PreviewDragOver="Omnibox_PreviewDragOver"
                             PreviewDrop="Omnibox_PreviewDrop"
                             PreviewKeyDown="PromptTextBox_PreviewKeyDown"
                             TextChanged="PromptTextBox_TextChanged" />
                    <TextBlock Text="{Binding PromptPlaceholder}"
                               Margin="2,12,0,0"
                               Foreground="#6B7280"
                               FontSize="16"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsPromptPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <ComboBox Grid.Column="2"
                          Width="156"
                          Height="38"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding OmniboxActions}"
                          IsEnabled="{Binding IsTaskInputEnabled}"
                          SelectedItem="{Binding SelectedOmniboxAction, Mode=TwoWay}" />

                <Button Grid.Column="3"
                        Style="{StaticResource VoiceButtonStyle}"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="Mic"
                        FontWeight="SemiBold"
                        IsEnabled="{Binding IsTaskInputEnabled}"
                        Command="{Binding ToggleVoiceCommand}" />

                <Button Grid.Column="4"
                        Width="54"
                        Height="38"
                        VerticalAlignment="Center"
                        Background="#4B5563"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Content="{Binding SendButtonText}"
                        Command="{Binding SendMessageCommand}" />
                </Grid>
            </Border>

        <Grid Grid.Row="3" Margin="12,8,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding LocalScrubberStatus}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" />

            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ApiLlmStatus}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <ProgressBar Width="118"
                             Height="7"
                             Margin="0,4,0,0"
                             Foreground="{StaticResource SuccessBrush}"
                             IsIndeterminate="True"
                             Visibility="{Binding IsApiLlmWorking, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding HostLlmStatus}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <ProgressBar Width="118"
                             Height="7"
                             Margin="0,4,0,0"
                             Foreground="{StaticResource SuccessBrush}"
                             IsIndeterminate="True"
                             Visibility="{Binding IsHostLlmWorking, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <TextBlock Grid.Column="3"
                       Text="{Binding VaultWriteStatus}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
