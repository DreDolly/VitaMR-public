<UserControl x:Class="VitaMR.Controls.RightPreviewPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsPreviewPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Border Width="320"
            Background="#F7FAFD"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1,0,0,0"
            Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right"
                        Content="x"
                        Width="28"
                        Height="28"
                        Padding="0"
                        FontWeight="Bold"
                        Background="#FFFFFF"
                        BorderBrush="#D6E4EF"
                        BorderThickness="1"
                        Command="{Binding ClosePreviewPanelCommand}"
                        ToolTip="Close review panel" />
                <TextBlock Text="{Binding PreviewPanelTitle}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="Vault folder"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right"
                        Content="Choose"
                        Width="68"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding ChooseVaultFolderCommand}" />
                <TextBox Text="{Binding VaultRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         Padding="7,4"
                         TextWrapping="NoWrap" />
            </DockPanel>

            <TextBlock Text="Active chart"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding ActiveChartId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,8" />

            <TextBlock Text="Local display name"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding ActivePatientDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,8" />

            <CheckBox Content="Synthetic test mode"
                      IsChecked="{Binding IsSyntheticTestMode, Mode=TwoWay}"
                      Margin="0,0,0,10" />

            <TextBlock Text="Chart manager"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding ChartManagerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,8" />

            <TextBlock Text="Manager confirmation"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding ChartManagerPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,10" />

            <TextBlock Text="Source system"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding SourceSystem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,8" />

            <TextBlock Text="Source facility"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding SourceFacility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,8" />

            <TextBlock Text="Source type"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding SourceTypes}"
                      SelectedItem="{Binding SelectedSourceType, Mode=TwoWay}"
                      Height="30"
                      Padding="7,2"
                      Margin="0,0,0,10" />

            <Border Background="White"
                    BorderBrush="#DCE6EF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox Content="Healthspan mode"
                              IsChecked="{Binding EnableHealthspanMode, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                    <TextBlock Text="Coaching intensity"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding HealthspanCoachingModes}"
                              SelectedItem="{Binding HealthspanCoachingMode, Mode=TwoWay}"
                              Height="30"
                              Padding="7,2"
                              Margin="0,0,0,8" />
                    <TextBlock Text="{Binding HealthspanModeSummary}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HealthspanModeDetail}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Button Content="Save Settings"
                    Height="32"
                    Margin="0,0,0,16"
                    Command="{Binding SaveSettingsCommand}" />

            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Width="72"
                        Height="28"
                        Command="{Binding RefreshPhoneInboxCommand}" />
                <TextBlock Text="Phone inbox"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding PhoneInboxItems}"
                          Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#DCE6EF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,4" />
                                <TextBlock Text="{Binding SourceDetail}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Note}"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="54" />
                                <TextBlock Text="{Binding Status}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="0,4,0,2" />
                                <TextBlock Text="{Binding MasterHuntHint}"
                                           Foreground="#087A66"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <UniformGrid Columns="2">
                                    <Button Content="Review"
                                            Margin="0,0,4,4"
                                            Command="{Binding DataContext.PhoneInboxActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ReviewParameter}" />
                                    <Button Content="Summarize"
                                            Margin="4,0,0,4"
                                            Command="{Binding DataContext.PhoneInboxActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding SummarizeParameter}" />
                                    <Button Content="Save only"
                                            Margin="0,4,4,0"
                                            Command="{Binding DataContext.PhoneInboxActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding SaveParameter}" />
                                    <Button Content="Add after confirm"
                                            Margin="4,4,0,0"
                                            Command="{Binding DataContext.PhoneInboxActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding AddParameter}" />
                                    <Button Content="Accept evidence"
                                            Margin="0,8,4,0"
                                            Command="{Binding DataContext.PhoneInboxActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding AcceptEvidenceParameter}" />
                                </UniformGrid>
                                <Button Content="Done / Archive"
                                        Margin="0,8,0,0"
                                        Command="{Binding DataContext.PhoneInboxActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ArchiveParameter}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Local privacy review"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <CheckBox Content="Required after scrub"
                      IsChecked="{Binding EnableLocalModelTestbed, Mode=TwoWay}"
                      IsEnabled="False"
                      Margin="0,0,0,8" />

            <TextBlock Text="Local endpoint"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding LocalModelEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,8" />

            <TextBlock Text="Local model"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding LocalModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,16" />

            <Border Background="#F7FBFA"
                    BorderBrush="#DDEDE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Provider setup"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ProviderSetupStatus}"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ProviderSetupDetail}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding ProviderOptions}"
                              SelectedItem="{Binding SelectedAiProvider, Mode=TwoWay}"
                              Height="30"
                              Margin="0,0,0,8" />
                    <TextBox Text="{Binding ProviderApiKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Padding="7,4"
                             Margin="0,0,0,8" />
                    <UniformGrid Columns="2">
                        <Button Content="Save key"
                                Height="30"
                                Margin="0,0,4,0"
                                Command="{Binding SaveProviderApiKeyCommand}" />
                        <Button Content="Clear key"
                                Height="30"
                                Margin="4,0,0,0"
                                Command="{Binding ClearProviderApiKeyCommand}" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="Gemini backend"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <CheckBox Content="Write sterile encounter nodes"
                      IsChecked="{Binding EnableGeminiBackendProcessing, Mode=TwoWay}"
                      Margin="0,0,0,8" />

            <TextBlock Text="Gemini fast model"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding GeminiFastModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,8" />

            <TextBlock Text="Gemini thinking model"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding GeminiThinkingModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Padding="7,4"
                     Margin="0,0,0,16" />

            <ItemsControl ItemsSource="{Binding PreviewLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#E4EAF1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
